  ;; bit before it in reading order. A byte at a time: L and R are the left and right neighbours of the byte's eight bits.
  ;; The page offers the rules whose information loss on a ring of 2^k bits is exact: 150 and 170 lose nothing, 60 one
  ;; bit a turn, 90 two bits a turn (nilpotent: all zero after 64 turns on 128 bits).
  (func $eca (param $p i32) (param $prm i32) (param $rule i32) (result i32)
    (local $out i32) (local $flags i32) (local $j i32) (local $c i32) (local $l i32) (local $r i32) (local $v i32) (local $q i32) (local $t i32) (local $changed i32)
    (local.set $out (i32.load (local.get $prm)))
    (local.set $flags (i32.load offset=36 (local.get $prm)))
    (block $je (loop $jl (br_if $je (i32.ge_u (local.get $j) (global.get $cw)))
      (local.set $c (i32.load8_u (i32.add (local.get $p) (local.get $j))))
      (local.set $l (i32.or (i32.shr_u (local.get $c) (i32.const 1))
        (i32.shl (i32.and (i32.load8_u (i32.add (local.get $p) (i32.rem_u (i32.add (local.get $j) (i32.sub (global.get $cw) (i32.const 1))) (global.get $cw)))) (i32.const 1)) (i32.const 7))))
      (local.set $r (i32.or (i32.and (i32.shl (local.get $c) (i32.const 1)) (i32.const 255))
        (i32.shr_u (i32.load8_u (i32.add (local.get $p) (i32.rem_u (i32.add (local.get $j) (i32.const 1)) (global.get $cw)))) (i32.const 7))))
      (local.set $v (i32.const 0)) (local.set $q (i32.const 0))
      (block $qe (loop $ql (br_if $qe (i32.ge_u (local.get $q) (i32.const 8)))
        (if (i32.and (i32.shr_u (local.get $rule) (local.get $q)) (i32.const 1)) (then
          (local.set $t (i32.and (i32.and
            (select (local.get $l) (i32.xor (local.get $l) (i32.const 255)) (i32.and (local.get $q) (i32.const 4)))
            (select (local.get $c) (i32.xor (local.get $c) (i32.const 255)) (i32.and (local.get $q) (i32.const 2))))
            (select (local.get $r) (i32.xor (local.get $r) (i32.const 255)) (i32.and (local.get $q) (i32.const 1)))))
          (local.set $v (i32.or (local.get $v) (local.get $t)))))
        (local.set $q (i32.add (local.get $q) (i32.const 1))) (br $ql)))
      (i32.store8 (i32.add (local.get $out) (local.get $j)) (local.get $v))
      (i32.store8 (i32.add (local.get $flags) (local.get $j)) (i32.ne (local.get $v) (local.get $c)))
      (local.set $changed (i32.add (local.get $changed) (i32.ne (local.get $v) (local.get $c))))
      (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $jl)))
    (i32.store offset=48 (local.get $prm) (i32.const 0))
    (local.get $changed))
